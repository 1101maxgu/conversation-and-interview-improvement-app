# Copy to .env.local and fill in AT LEAST ONE provider key. Everything else is optional: a missing value switches
# that feature off cleanly. Keys stay on the server; only the two NEXT_PUBLIC_SUPABASE_* values reach the browser.

# ---- AI providers (at least one key; providers without a key are skipped) ----
# Google Gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras. Get a key at https://cloud.cerebras.ai (API keys)
CEREBRAS_API_KEY=
# NVIDIA NIM. Get a key at https://build.nvidia.com (sign in, then generate an API key)
NVIDIA_API_KEY=
# OpenRouter (free models). Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Bytez (last resort). Get a key at https://bytez.com (sign in, then create an API key in your account settings)
BYTEZ_API_KEY=

# Optional: override the model each provider uses. Leave blank for the defaults in lib/llm.ts.
GEMINI_MODEL=
GROQ_MODEL=
CEREBRAS_MODEL=
NVIDIA_MODEL=
OPENROUTER_MODEL=
BYTEZ_MODEL=

# Advanced: each provider also accepts <NAME>_BASE_URL and <NAME>_REASONING_EFFORT (see the header of lib/llm.ts),
# and CHAT_MAX_TOKENS (default 200) caps the length of a spoken reply.

# Optional: the order providers are tried in. Leave blank for the default order in lib/llm.ts.
LLM_PROVIDER_ORDER=

# ---- Durable rate limits (optional) ----
# Upstash Redis. Create a free database at https://console.upstash.com, then copy both values from its "REST API" box.
# Without them the limiter is in memory: fine for local development, too loose for a real deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Accounts and saved history (optional) ----
# Supabase. Create a free project at https://supabase.com/dashboard, then Project Settings -> API (or the "Connect" button).
# Project URL, for example https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The public "anon" key (or the newer "publishable" key). NEVER put the service_role / secret key here or anywhere in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Limits (optional, defaults shown) ----
# Rate limits count per signed-in user, or per client IP for guests.
# Chat requests per minute
LIMIT_CHAT_PER_MIN=40
LIMIT_PLAN_PER_MIN=10
LIMIT_PLAN_PER_HOUR=30
# "Get notes" requests per hour
LIMIT_NOTES_PER_HOUR=6
# Saved-history requests per minute (signed-in users)
LIMIT_SESSIONS_PER_MIN=60
# User turns per session before the companion wraps up
LIMIT_MAX_TURNS=40
# Maximum characters in one message
LIMIT_MAX_MESSAGE_CHARS=2000
# Maximum characters in one free-text setup field
LIMIT_MAX_FREE_TEXT_CHARS=2000
